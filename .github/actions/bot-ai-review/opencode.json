{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/local/bin/ai-review-shell",
  "formatter": false,
  "lsp": false,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "deny",
      "/tmp/ai-review/data/**": "allow"
    },
    "skill": "deny",
    "bash": {
      "*": "deny",
      "cd *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip install *": "allow",
      "pip3 install *": "allow",
      "pytest*": "allow",
      "./runtests": "allow",
      "./runtests *": "allow",
      "./runtests *;*": "deny",
      "./runtests *|*": "deny",
      "./runtests *&*": "deny",
      "./runtests *>*": "deny",
      "./runtests *<*": "deny",
      "./runtests *$*": "deny",
      "./runtests *`*": "deny",
      "./run-qa-checks*": "allow",
      "./manage.py test*": "allow",
      "node *": "allow",
      "npm ci*": "allow",
      "npm install*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npx jest*": "allow",
      "yarn install*": "allow",
      "yarn test*": "allow",
      "lua *": "allow",
      "busted*": "allow",
      "ls": "allow",
      "ls -la": "allow",
      "which chromium": "allow",
      "which chromium-browser": "allow",
      "which google-chrome": "allow",
      "which chromedriver": "allow",
      "which chromium chromium-browser google-chrome chromedriver": "allow",
      "yarn --version": "allow",
      "./tests/manage.py test*": "allow",
      "SAMPLE_APP=1 ./tests/manage.py test*": "allow",
      "ls *": "allow",
      "ls *>*": "deny",
      "ls *<*": "deny",
      "ls *$*": "deny",
      "ls *`*": "deny"
    }
  }
}
